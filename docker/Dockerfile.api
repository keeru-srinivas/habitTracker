# Habit Tracker API. Build context: repo root.
#   docker build -f docker/Dockerfile.api -t habit-api:latest .
FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    HABITTRACKER_PORT=9210 \
    DEBUG=false \
    FIREBASE_CREDENTIALS_PATH=/app/firebase-config.json

WORKDIR /app

COPY backend/requirements.txt .
RUN pip install --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

COPY backend/main.py backend/config.py backend/firebase_config.py backend/models.py ./
COPY backend/util/ ./util/
COPY backend/templates/ ./templates/
# firebase-config.json is mounted at runtime (K8s secret), not baked into the image.

EXPOSE 9210

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:9210/api/health', timeout=4)" || exit 1

CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${HABITTRACKER_PORT:-9210}"]
